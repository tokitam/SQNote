{% extends 'layout.html.twig' %}
{% block title %}ノートブック — SQNote{% endblock %}
{% block content %}
<h2>ノートブック</h2>
<ul class="notebook-list">
  {% for nb in notebooks %}
    <li><a href="/notebooks/{{ nb.id }}">{{ nb.name }} <span class="count">{{ nb.note_count }}</span></a></li>
  {% endfor %}
</ul>
{% endblock %}
