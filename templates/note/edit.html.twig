{% extends 'layout.html.twig' %}

{% block title %}{{ note ? 'ノート編集' : '新規ノート' }} — SQNote{% endblock %}

{% block head %}
{% if note and note.content_type == 'html' %}
  <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">
{% endif %}
{% endblock %}

{% block content %}
<div class="note-editor">
  <div class="editor-toolbar">
    <input type="text" id="note-title" class="editor-title" placeholder="タイトル" value="{{ note ? note.title : '' }}">
    <div class="editor-meta">
      <select id="note-notebook">
        <option value="">ノートブックなし</option>
        {% for nb in notebooks %}
          <option value="{{ nb.id }}" {{ note and note.notebook_id == nb.id ? 'selected' : '' }}>{{ nb.name }}</option>
        {% endfor %}
      </select>
      <input type="text" id="note-tags" placeholder="タグ（カンマ区切り）" value="{{ note ? note.tags|join(', ') : '' }}">
    </div>
    <div class="editor-actions">
      <button class="btn btn-primary" id="save-btn" data-note-id="{{ note ? note.id : '' }}">保存</button>
      <a href="{{ note ? '/notes/' ~ note.id : '/' }}" class="btn">キャンセル</a>
      <button class="btn" id="attach-btn" type="button">📎 添付</button>
      <input type="file" id="attach-input" multiple
             accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml,application/pdf,text/plain,text/csv,text/markdown,application/zip,application/x-zip-compressed,.zip"
             style="display:none">
    </div>
  </div>

  {% if note and note.content_type == 'html' %}
    {# Quill WYSIWYG エディタ（html ノート用） #}
    <input type="hidden" id="content-type" value="html">
    <div id="editor-quill">{{ note.content|raw }}</div>
  {% else %}
    {# Markdown エディタ: textarea をフォールバックとして常に表示し、CodeMirror が読み込めた場合に置き換える #}
    <input type="hidden" id="content-type" value="markdown">
    <textarea id="editor-md" class="editor-cm" style="width:100%;box-sizing:border-box;padding:8px;font-family:monospace;font-size:14px;line-height:1.6;resize:vertical;border:1px solid var(--color-border);border-radius:4px;">{{ note ? note.content : '' }}</textarea>
    <div id="editor-cm" class="editor-cm" style="display:none"></div>
  {% endif %}

  <div id="save-status" class="save-status"></div>

  <div id="attach-panel" class="attach-panel" style="{{ note and note.attachments|length > 0 ? '' : 'display:none' }}">
    <div class="attach-panel-header">
      添付ファイル <span id="attach-count">{{ note ? note.attachments|length : 0 }}</span> 件
    </div>
    <ul class="attach-list" id="attach-list">
      {% if note %}
        {% for att in note.attachments %}
          <li class="attach-item" data-id="{{ att.id }}">
            {% if att.mime_type starts with 'image/' %}
              <img src="/api/v1/attachments/{{ att.id }}" class="attach-thumb" alt="{{ att.filename }}">
            {% else %}
              <span class="attach-icon">📄</span>
            {% endif %}
            <span class="attach-name" title="{{ att.filename }}">{{ att.filename }}</span>
            <button class="attach-delete" type="button" data-id="{{ att.id }}" title="削除">×</button>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
    <div class="attach-drop-hint">ここにファイルをドロップ</div>
  </div>

  <div id="attach-toast" class="attach-toast" style="display:none"></div>
</div>

{# 既存タグのオートコンプリート用 datalist #}
<datalist id="tag-suggestions">
  {% for tag in tags %}
    <option value="{{ tag.name }}">
  {% endfor %}
</datalist>
{% endblock %}

{% block scripts %}
{% if note and note.content_type == 'html' %}
  <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
  <script>
    const quill = new Quill('#editor-quill', {
      theme: 'snow',
      formats: ['bold','italic','underline','strike','code','link','header','list','blockquote','code-block','image'],
    });
    window._editor = { getContent: () => quill.root.innerHTML };
    // フォーカスが外れた（range === null）ら自動保存
    quill.on('selection-change', range => { if (range === null) window.autoSave?.(); });
  </script>
{% else %}
  <script type="module">
    try {
      const cm    = await import('https://esm.sh/codemirror@6?bundle');
      const mdPkg = await import('https://esm.sh/@codemirror/lang-markdown@6?bundle');

      const ta   = document.getElementById('editor-md');
      const cmEl = document.getElementById('editor-cm');
      const view = new cm.EditorView({
        doc: ta.value,
        extensions: [cm.basicSetup, mdPkg.markdown()],
        parent: cmEl,
      });
      ta.style.display   = 'none';
      cmEl.style.display = '';
      window._cmView = view;
      window._editor = { getContent: () => view.state.doc.toString() };
      // エディタからフォーカスが外れたら自動保存（blur はバブリングしないので capture で捕捉）
      view.dom.addEventListener('blur', () => window.autoSave?.(), true);
    } catch (e) {
      console.warn('CodeMirror の読み込みに失敗しました。テキストエリアで入力できます。', e);
      window._editor = { getContent: () => document.getElementById('editor-md').value };
    }
  </script>
{% endif %}
<script>
  let NOTE_ID  = document.getElementById('save-btn').dataset.noteId || null;
  const tagInput = document.getElementById('note-tags');
  tagInput.setAttribute('list', 'tag-suggestions');

  // 保存済みコンテンツ・保存中フラグ（自動保存の重複/競合防止に使う）
  let _lastSavedContent = (document.getElementById('editor-md')?.value)
                       ?? (document.getElementById('editor-quill')?.innerHTML)
                       ?? '';
  let isSaving = false;

  const statusEl = document.getElementById('save-status');
  let _statusTimer = null;
  function showStatus(msg, { error = false, muted = false, persist = false } = {}) {
    if (_statusTimer) { clearTimeout(_statusTimer); _statusTimer = null; }
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden', 'error', 'muted');
    if (error) statusEl.classList.add('error');
    if (muted) statusEl.classList.add('muted');
    if (!persist) {
      _statusTimer = setTimeout(() => { statusEl.classList.add('hidden'); }, 2000);
    }
  }

  async function saveNote(auto = false, redirect = false) {
    const btn = document.getElementById('save-btn');
    if (isSaving) return NOTE_ID;
    isSaving = true;
    btn.disabled = true;
    showStatus(auto ? '自動保存中...' : '保存中...', { persist: true, muted: auto });

    const tags = tagInput.value.split(',').map(t => t.trim()).filter(Boolean);
    const body = {
      title:        document.getElementById('note-title').value,
      content:      window._editor ? window._editor.getContent() : '',
      content_type: document.getElementById('content-type').value,
      notebook_id:  document.getElementById('note-notebook').value || null,
      tags,
    };

    const url    = NOTE_ID ? '/api/v1/notes/' + NOTE_ID : '/api/v1/notes';
    const method = NOTE_ID ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        credentials: 'same-origin',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        showStatus(`保存失敗: HTTP ${res.status}`, { error: true });
        return;
      }
      const data = await res.json();
      if (data.ok) {
        _lastSavedContent = body.content;
        if (!NOTE_ID) {
          NOTE_ID = data.data.id;
          document.getElementById('save-btn').dataset.noteId = NOTE_ID;
          history.pushState({}, '', '/notes/' + NOTE_ID + '/edit');
        }
        // 手動保存（保存ボタン / Cmd+S）のときは閲覧画面へ戻る
        if (redirect && NOTE_ID) {
          window.location.href = '/notes/' + NOTE_ID;
          return NOTE_ID;
        }
        showStatus(auto ? '自動保存しました' : '保存しました', { muted: auto });
      } else {
        showStatus('保存失敗: ' + data.error.message, { error: true });
      }
    } catch (e) {
      showStatus('エラー: ' + e.message, { error: true });
    } finally {
      isSaving = false;
      btn.disabled = false;
    }
    return NOTE_ID;
  }

  // blur トリガーの自動保存（500ms デバウンス）
  let _autoSaveTimer = null;
  function autoSave() {
    if (_autoSaveTimer) clearTimeout(_autoSaveTimer);
    _autoSaveTimer = setTimeout(() => {
      if (!NOTE_ID) return;          // 新規ノートは保存先未確定のため自動保存しない
      if (isSaving) return;          // 手動保存と競合しない
      const current = window._editor ? window._editor.getContent() : '';
      if (current === _lastSavedContent) return;  // 変更がなければ保存しない
      saveNote(true);
    }, 500);
  }
  window.autoSave = autoSave;

  document.getElementById('save-btn').addEventListener('click', () => saveNote(false, true));
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); saveNote(false, true); }
  });

  // textarea フォールバック時の blur 自動保存（CodeMirror 読み込み失敗時に有効）
  document.getElementById('editor-md')?.addEventListener('blur', autoSave);

  // ===== 添付ファイル =====
  const attachState = { uploading: false };

  async function ensureNoteId() {
    if (NOTE_ID) return NOTE_ID;
    return await saveNote();
  }

  function insertMarkdown(md) {
    if (window._cmView) {
      const view = window._cmView;
      const { from } = view.state.selection.main;
      view.dispatch({ changes: { from, insert: md } });
      view.focus();
      return;
    }
    const ta = document.getElementById('editor-md');
    if (!ta) return;
    const s = ta.selectionStart;
    ta.value = ta.value.slice(0, s) + md + ta.value.slice(ta.selectionEnd);
    ta.selectionStart = ta.selectionEnd = s + md.length;
    ta.focus();
  }

  function showToast(msg, type = 'success') {
    const toast = document.getElementById('attach-toast');
    toast.textContent = msg;
    toast.className   = 'attach-toast attach-toast--' + type;
    toast.style.display = '';
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  function addPanelItem(att) {
    const list  = document.getElementById('attach-list');
    const count = document.getElementById('attach-count');
    const panel = document.getElementById('attach-panel');

    const li = document.createElement('li');
    li.className = 'attach-item';
    li.dataset.id = att.id;

    if (att.mime_type.startsWith('image/')) {
      const img = document.createElement('img');
      img.src = att.url;
      img.className = 'attach-thumb';
      img.alt = att.filename;
      img.addEventListener('click', () => insertMarkdown('![' + att.filename + '](' + att.url + ')'));
      li.appendChild(img);
    } else {
      const icon = document.createElement('span');
      icon.className = 'attach-icon';
      icon.textContent = '📄';
      li.appendChild(icon);
    }

    const name = document.createElement('span');
    name.className = 'attach-name';
    name.title = att.filename;
    name.textContent = att.filename;
    li.appendChild(name);

    const del = document.createElement('button');
    del.className = 'attach-delete';
    del.type = 'button';
    del.textContent = '×';
    del.dataset.id = att.id;
    del.addEventListener('click', () => deleteAttachment(att.id));
    li.appendChild(del);

    list.appendChild(li);
    count.textContent = list.children.length;
    panel.style.display = '';
  }

  function removePanelItem(id) {
    const li    = document.querySelector('#attach-list [data-id="' + id + '"]');
    const count = document.getElementById('attach-count');
    const panel = document.getElementById('attach-panel');
    if (li) li.remove();
    const remaining = document.getElementById('attach-list').children.length;
    count.textContent = remaining;
    if (remaining === 0) panel.style.display = 'none';
  }

  async function deleteAttachment(id) {
    if (!confirm('添付ファイルを削除しますか？')) return;
    const res = await fetch('/api/v1/attachments/' + id, {
      method: 'DELETE',
      credentials: 'same-origin',
    });
    if (res.ok) {
      removePanelItem(id);
    } else {
      showToast('削除に失敗しました', 'error');
    }
  }

  async function uploadFile(file) {
    const MAX = 20 * 1024 * 1024;
    if (file.size > MAX) {
      showToast(file.name + ' は 20MB を超えています', 'error');
      return;
    }

    if (attachState.uploading) return;
    attachState.uploading = true;
    document.getElementById('attach-btn').disabled = true;

    try {
      const noteId = await ensureNoteId();
      if (!noteId) { showToast('ノートの保存に失敗しました', 'error'); return; }

      const form = new FormData();
      form.append('file', file);

      const res = await fetch('/api/v1/notes/' + noteId + '/attachments', {
        method: 'POST',
        credentials: 'same-origin',
        body: form,
      });

      const json = await res.json();
      if (!res.ok || !json.ok) {
        showToast('アップロード失敗: ' + (json.error?.message ?? res.status), 'error');
        return;
      }

      const att = json.data;
      addPanelItem(att);

      const isImage = att.mime_type.startsWith('image/');
      const md = isImage
        ? '![' + att.filename + '](' + att.url + ')'
        : '[' + att.filename + '](' + att.url + ')';
      insertMarkdown(md);

      showToast(att.filename + ' を添付しました', 'success');
    } catch (e) {
      showToast('エラー: ' + e.message, 'error');
    } finally {
      attachState.uploading = false;
      document.getElementById('attach-btn').disabled = false;
    }
  }

  document.getElementById('attach-btn').addEventListener('click', () => {
    document.getElementById('attach-input').click();
  });

  document.getElementById('attach-input').addEventListener('change', async e => {
    const files = Array.from(e.target.files);
    e.target.value = '';
    for (const file of files) await uploadFile(file);
  });

  document.addEventListener('paste', async e => {
    const files  = Array.from(e.clipboardData?.files ?? []);
    const images = files.filter(f => f.type.startsWith('image/'));
    if (images.length === 0) return;
    e.preventDefault();
    for (const file of images) await uploadFile(file);
  });

  const dropTargets = [
    document.getElementById('editor-cm'),
    document.getElementById('editor-md'),
    document.getElementById('attach-panel'),
  ].filter(Boolean);

  dropTargets.forEach(el => {
    el.addEventListener('dragover', e => {
      e.preventDefault();
      el.classList.add('drag-over');
    });
    el.addEventListener('dragleave', () => el.classList.remove('drag-over'));
    el.addEventListener('drop', async e => {
      e.preventDefault();
      el.classList.remove('drag-over');
      const files = Array.from(e.dataTransfer.files);
      for (const file of files) await uploadFile(file);
    });
  });

  document.querySelectorAll('.attach-delete[data-id]').forEach(btn => {
    btn.addEventListener('click', () => deleteAttachment(btn.dataset.id));
  });
</script>
{% endblock %}
