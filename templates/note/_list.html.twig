{% if notes is empty %}
  <p class="empty">ノートがありません。</p>
{% else %}
  <ul class="note-list">
    {% for note in notes %}
      <li class="note-item">
        <a href="/notes/{{ note.id }}" class="note-item-link">
          <div class="note-item-title">{{ note.title ?: '(無題)' }}</div>
          {% if note.excerpt %}
            <div class="note-item-excerpt">{{ note.excerpt|striptags|slice(0, 120) }}</div>
          {% endif %}
          <div class="note-item-meta">
            {% for tag in note.tags %}<span class="tag">#{{ tag }}</span>{% endfor %}
            <span class="date">{{ note.updated_at|slice(0,10) }}</span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
  {% if pages > 1 %}
    <nav class="pagination">
      {% if page > 1 %}<a href="?page={{ page - 1 }}">&laquo;</a>{% endif %}
      <span>{{ page }} / {{ pages }}</span>
      {% if page < pages %}<a href="?page={{ page + 1 }}">&raquo;</a>{% endif %}
    </nav>
  {% endif %}
{% endif %}
