{
    "name": "tokitam/sqnote",
    "description": "SQLite-based note-taking application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^7.0",
        "twig/twig": "^3.0",
        "league/commonmark": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "SQNote\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
